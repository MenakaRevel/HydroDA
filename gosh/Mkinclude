#==========================================================
# GNU Fortran (gfortran)
#==========================================================

# Fortran Compiler
FC      = gfortran

# Compiler Options
FFLAGS  = -O3 \
          -fno-automatic \
          -fPIC \
          -fbacktrace \
          -g \
          -fcheck=all \
          -finit-real=nan \
          -Wall \
          -fopenmp          # Include this if using OpenMP

# Include Directories
INC     = -I/usr/include \
          -I/usr/local/include #\
        #   -I$(MKLROOT)/include    # Add MKL include if used

# Library Directories and MKL linking
LIB     = -L/usr/lib \
          -L/usr/local/lib \
        #   -L$(MKLROOT)/lib/intel64 \
        #   -Wl,--start-group \
        #       -lmkl_intel_lp64 \
        #       -lmkl_gnu_thread \
        #       -lmkl_core \
        #   -Wl,--end-group \
          -lgomp \
          -lpthread \
          -lm \
          -ldl

